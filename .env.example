# Copiar a .env (credenciales solo para la PoC local; no usar en entornos reales)
MSSQL_SA_PASSWORD=Makers_PoC_2026!
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password123

# Versiones de imagen
SPARK_IMAGE_TAG=3.5.6-python3
REDPANDA_IMAGE_TAG=v24.2.7
REDPANDA_CONSOLE_IMAGE_TAG=v2.7.2
DEBEZIUM_IMAGE_TAG=2.7.3.Final
CURL_IMAGE_TAG=8.10.1
SEAWEEDFS_IMAGE_TAG=3.97
AWS_CLI_IMAGE_TAG=2.27.50
ICEBERG_REST_IMAGE_TAG=1.10.1

# Topic CDC: <topic.prefix>.<database>.<schema>.<table>
AUDIT_TOPIC=mssql.AuditDb.dbo.AuditOutbox
# Ventana de replay: 7 días
AUDIT_TOPIC_RETENTION_MS=604800000

# Ingesta
MAX_OFFSETS_PER_TRIGGER=50000
TRIGGER_MODE=processing
TRIGGER_INTERVAL=30 seconds

# Generador de carga
LOAD_BATCH_ROWS=500
LOAD_INTERVAL_SECONDS=2
LOAD_BATCHES=0

# Mantenimiento
COMPACT_INCLUDE_OPEN_PARTITIONS=true
AUDIT_RETENTION_DAYS=2555
SNAPSHOT_RETENTION_HOURS=24
SNAPSHOT_RETAIN_LAST=10

# Core .NET: ventana caliente de la outbox en SQL Server (PoC corta para verla purgar)
OUTBOX_RETENTION_MINUTES=5
OUTBOX_RETENTION_INTERVAL_SECONDS=30

# Demo end-to-end (servicio e2e)
E2E_ACCOUNTS=20
E2E_PAYMENTS=2000
E2E_TIMEOUT_SECONDS=600
